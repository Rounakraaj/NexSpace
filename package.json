{
  "name": "nexspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "collab": "node --env-file-if-exists=.env --import tsx collaboration/server.ts",
    "collab:dev": "node --env-file-if-exists=.env --import tsx --watch collaboration/server.ts",
    "canvas": "node --env-file-if-exists=.env --import tsx collaboration/canvas-server.ts",
    "canvas:dev": "node --env-file-if-exists=.env --import tsx --watch collaboration/canvas-server.ts",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@hocuspocus/extension-redis": "^4.8.0",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@hocuspocus/transformer": "^4.8.0",
    "@prisma/client": "^5.22.0",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-collaboration-caret": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tldraw/state": "^5.6.0",
    "@tldraw/sync": "^5.6.0",
    "@tldraw/sync-core": "^5.6.0",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.10.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.14.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldraw": "^5.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.23.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}

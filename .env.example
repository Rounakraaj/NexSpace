# Required for the account dashboard and authenticated features.
# Local development defaults to a PostgreSQL database on localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexspace?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nexspace?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST="true"
# Optional Google OAuth; email/password sign-in works without these values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local endpoints used by the all-in-one npm run dev command.
# Production must set NEXT_PUBLIC_COLLABORATION_URL to the browser-reachable wss:// endpoint.
COLLABORATION_URL="ws://localhost:1234"
NEXT_PUBLIC_COLLABORATION_URL="ws://localhost:1234"
COLLABORATION_PORT="1234"
# Shared by the Next.js app, page collaboration, and Canvas service. Keep private.
COLLABORATION_SECRET="" # Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
# Collaborative tldraw Canvas service; npm run dev starts it automatically.
# Production must set NEXT_PUBLIC_CANVAS_URL to the browser-reachable wss:// endpoint.
CANVAS_URL="ws://localhost:1235"
NEXT_PUBLIC_CANVAS_URL="ws://localhost:1235"
CANVAS_PORT="1235"
NEXT_PUBLIC_TLDRAW_LICENSE_KEY="" # Required by tldraw's license terms for production use
# Optional in single-process local development; required for shared limits in production.
# Use redis:// or rediss:// (including Upstash's native Redis URL, not its HTTPS REST URL).
REDIS_URL=""
# Enable only when running multiple Hocuspocus instances.
COLLABORATION_REDIS_ENABLED="false"
# Optional; required only for Canvas image attachments. Create this as a private bucket.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexspace-attachments"
# Optional; only AI Copilot uses this key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
